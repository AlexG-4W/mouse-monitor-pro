# Сборка PyInstaller
build/
dist/
*.pyc
__pycache__/
*.spec.bak

# Виртуальные окружения
venv/
.venv/
env/

# --- ВЫВОД ПРИЛОЖЕНИЯ: ЭТО ЛИЧНЫЕ ДАННЫЕ -------------------------------------
# Журнал сессии содержит координаты курсора с метками времени, то есть запись
# того, что человек делал за компьютером и когда. Теплокарта -- то же самое в
# виде картинки: по ней видно раскладку окон и рабочие привычки. Текстовая
# сводка несёт имена файлов и параметры машины.
#
# Ничего из этого не должно попасть в репозиторий НИ У КОГО -- ни у автора,
# ни у того, кто сделает форк и запустит программу в клоне. Поэтому шаблоны
# перечислены и по каталогу, и по расширению: каталог защищает вывод при
# настройках по умолчанию, расширение -- файлы, оказавшиеся в корне, если
# программа запущена из другого места.
logs/
heatmaps/
*.csv
*_summary.txt
*.log
mouse_monitor.log
